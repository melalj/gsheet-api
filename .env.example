# Google Service Account Credentials (base64 encoded)
# Generate with: base64 -w 0 credentials.json
GOOGLE_CREDENTIALS=

# Server Configuration
PORT=3000
HOST=0.0.0.0

# API Key Protection (optional)
# Header-based: X-Private-Api-Key header
PRIVATE_API_KEY=

# Query string-based: ?key= parameter
PRIVATE_API_KEY_QUERY=

# Environment
NODE_ENV=development
